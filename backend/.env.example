# Copy this to backend/.env and fill it in. `lopper serve` and `lopper db-init` read that file
# (a variable you set in your shell wins). backend/.env is git-ignored, so keep secrets there.
# All of these are optional except the GitHub ones, which switch sign-in on.

# Where the data lives. Leave this out to use the SQLite file backend/lopper.db.
# For Postgres (for example Supabase's transaction pooler) use its address, and install the driver with
# `pip install -e ".[postgres]"`:
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# Or keep SQLite somewhere else:
# DATABASE_PATH=

# Only when the site forwards /api to this server (Cloudflare Pages): the secret it shares with the forwarder.
# PROXY_SECRET=

# Browser origins allowed to call the API, comma separated. Add your site's address in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How many scans can run at once, and how many one address can start per minute.
SCAN_WORKERS=2
SCANS_PER_MINUTE=6

# --- Ask about a scan (see "Ask about a scan" in README.md) ---
# Switches on the chat panel on the results page. Leave the key empty and the panel doesn't appear. Every question uses
# your OpenRouter credits, and is made from this server. The key never goes to the browser. Get one at https://openrouter.ai/keys.
OPEN_ROUTER_API_KEY=
# Which model answers, as an OpenRouter id (see https://openrouter.ai/models). If you leave this out, google/gemini-2.5-flash is used.
# AI_MODEL=google/gemini-2.5-flash
# How many questions one address can send per minute.
# CHATS_PER_MINUTE=10

# --- Sign in with GitHub (see "Sign in with GitHub" in README.md) ---
# From your GitHub OAuth app:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional, for running on your own machine: a second OAuth app whose callback URL is
#   http://localhost:5173/api/auth/github/callback
# When both of these are set they are used instead of the two above, so one .env can hold both apps.
# Leave them out on the server.
# CLIENT_ID=
# CLIENT_SECRET=
# A long random string that signs the sign-in state and encrypts stored GitHub tokens. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it. If you change it, everyone has to sign in again.
SECRET_KEY=
# Where the site is. People are sent back here after signing in. Use https:// in production.
FRONTEND_URL=http://localhost:5173
# What Lopper asks GitHub for. `repo` lets it read private repos you can access.
GITHUB_SCOPES=read:user repo
