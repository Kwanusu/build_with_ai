# The API reads these from environment variables. It doesn't load this file by itself,
# so set them in your shell or your host's settings. All of them are optional.

# Where Postgres is. The dev database from `python scripts/dev_db.py start` is:
DATABASE_URL=postgresql://lopper@localhost:5544/lopper

# Browser origins allowed to call the API, comma separated. Add your site's address in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How many scans can run at once, and how many one address can start per minute.
SCAN_WORKERS=2
SCANS_PER_MINUTE=6
