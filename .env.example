# Front end settings. Copy to .env.local to change them. Both are optional.

# Where the Flask API is when you run `npm run dev` (Vite forwards /api to it).
VITE_API_PROXY=http://127.0.0.1:5000

# The API's address in a production build. Leave empty if the site and the API share one address.
VITE_API_URL=
